<!--
  Portable folder build (CyberleekViewer-style): self-contained publish of
  exe + DLLs, zipped for distribution. Runs on any 64-bit Windows 10/11
  without the .NET runtime installed. Folder layout (instead of a bundled
  single file) keeps startup fast and triggers fewer AV false positives.
  Use from Visual Studio: right-click DeepSeekHarness project -> Publish,
  profile "PortableFolder" -> Publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
