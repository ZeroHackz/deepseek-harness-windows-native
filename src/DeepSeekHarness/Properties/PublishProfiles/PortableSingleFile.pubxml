<!--
  Portable single-file build (BunkrDownloader-style): one self-contained exe
  that bundles the .NET runtime and the native WebView2 loader, extracting
  native libraries to the temp folder at startup. Use from Visual Studio:
  right-click DeepSeekHarness project -> Publish, profile
  "PortableSingleFile" -> Publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\singlefile\</PublishDir>
  </PropertyGroup>
</Project>
