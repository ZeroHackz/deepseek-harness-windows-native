<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeepSeekHarness</AssemblyName>
    <RootNamespace>DShNative</RootNamespace>
    <!-- Versioning policy: <Version> is the intended release date in
         yyyy.MM.dd form, and we ship at most one release per day. Rebuilds
         within the same day keep the same version; anything not tested in
         time waits for the next day. -->
    <Version>2026.09.03</Version>
    <!-- Official DeepSeek artwork (assets are regenerated by tools\update-icons.ps1):
         light/color variant from https://deepseek.com/favicon.ico
         dark variant (white whale) from https://platform.deepseek.com/favicon.svg -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\icon-light.ico" LogicalName="DShNative.icon-light.ico" />
    <EmbeddedResource Include="assets\icon-dark.ico" LogicalName="DShNative.icon-dark.ico" />
    <!-- Splash loading visual (animated GIFs play automatically) -->
    <EmbeddedResource Include="..\..\assets\source\loading_splash_image.gif" LogicalName="DShNative.splash.gif" />
  </ItemGroup>

</Project>
