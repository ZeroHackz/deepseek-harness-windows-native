<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeepSeekHarness</AssemblyName>
    <RootNamespace>DShNative</RootNamespace>
    <Version>2026.09.28</Version>
    <!-- Official DeepSeek artwork (assets are regenerated by tools\update-icons.ps1):
         light/color variant from https://deepseek.com/favicon.ico
         dark variant (white whale) from https://platform.deepseek.com/favicon.svg -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\icon-light.ico" LogicalName="DShNative.icon-light.ico" />
    <EmbeddedResource Include="assets\icon-dark.ico" LogicalName="DShNative.icon-dark.ico" />
    <!-- Splash loading clips (randomly chosen per launch) -->
    <EmbeddedResource Include="..\..\assets\load_screen.mp4" LogicalName="DShNative.splash.1.mp4" />
    <EmbeddedResource Include="..\..\assets\load_screen_2.mp4" LogicalName="DShNative.splash.2.mp4" />
  </ItemGroup>

</Project>
